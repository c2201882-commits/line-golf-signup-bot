LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# LIFF app id, e.g. "1234567890-AbCdEfGh" (from LINE Developers Console > your channel > LIFF tab)
LIFF_ID=your_liff_id_here
# The channel id the LIFF app belongs to (same console page, "Channel ID" — used to verify id_tokens server-side)
LINE_LIFF_CHANNEL_ID=your_channel_id_here

# Random secret guarding /api/admin/backup and /api/admin/restore (used to
# preserve sign-up data across deploys on hosts with ephemeral disks).
ADMIN_SECRET=your_random_secret_here

# Directory to store signups.json in — point this at a mounted persistent
# disk in production (e.g. Render: /var/data). Defaults to ./data locally.
DATA_DIR=

PORT=3000
